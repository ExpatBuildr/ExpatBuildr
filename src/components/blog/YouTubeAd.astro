---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`youtube-ad-banner w-full ${className}`}>
  <a
    href="https://www.youtube.com/@expatbuildr?sub_confirmation=1"
    target="_blank"
    rel="noopener noreferrer"
    class="block rounded-3xl overflow-hidden border border-slate-200 dark:border-white/10 hover:border-red-500/40 transition-all duration-300 hover:scale-[1.005] shadow-lg hover:shadow-red-500/10"
  >
    <img
      src="/ads/youtube.jpg"
      alt="Learn how to Earn USD and Stay Anywhere Abroad — Subscribe on YouTube @expatbuildr"
      class="w-full h-auto block"
      loading="lazy"
    />
  </a>
</div>
