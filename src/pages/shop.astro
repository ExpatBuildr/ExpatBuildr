<!-- ══════════════════════════════════════════════
     PROCESSING OVERLAY
     2-second branded delay before checkout redirect
     Maintains brand authority / feels intentional
════════════════════════════════════════════════ -->
<div class="processing-overlay" id="processing-overlay">
  <div class="processing-logo">Expat<span>Buildr</span></div>
  <div class="processing-spinner"></div>
  <div class="processing-text">Preparing your checkout</div>
  <div class="processing-sub">Redirecting to secure checkout...</div>
</div>


<script is:inline>
  // ── STATE ──
  let currentEtsyUrl  = null;
  let currentProduct  = null;
  let currentPrice    = null;

  // ── OPEN EMAIL GATE ──
  function openGate(productName, checkoutUrl, price) {
    currentProduct  = productName;
    currentEtsyUrl  = checkoutUrl;
    currentPrice    = price;

    document.getElementById('modal-product-ref').textContent = '// ' + productName;
    document.getElementById('modal-title').textContent = 'One step to checkout.';
    document.getElementById('modal-sub').textContent =
      'Enter your email — we\'ll add you to Galaxy Arbitrage (free weekly remote jobs + income intel), then take you straight to checkout.';
    document.getElementById('modal-btn-text').textContent = 'Proceed to Checkout →';

    document.getElementById('modal-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('gate-email').focus(), 300);
  }

  // ── CLOSE GATE ──
  function closeGate() {
    document.getElementById('modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
    // reset btn
    document.getElementById('modal-btn-text').textContent = 'Proceed to Checkout →';
    document.getElementById('modal-btn').disabled = false;
  }

  function handleOverlayClick(e) {
    if (e.target === document.getElementById('modal-overlay')) closeGate();
  }

  // ── GATE SUBMIT ──
  // Flow: validate → subscribe Beehiiv → show processing overlay → open Stripe checkout
  async function handleGateSubmit() {
    const email = document.getElementById('gate-email').value.trim();
    const name  = document.getElementById('gate-name').value.trim();

    if (!email || !email.includes('@')) {
      const el = document.getElementById('gate-email');
      el.style.borderColor = '#FF6FD8';
      el.focus();
      setTimeout(() => el.style.borderColor = '', 2000);
      return;
    }

    // Update button state
    const btn = document.getElementById('modal-btn');
    btn.disabled = true;
    document.getElementById('modal-btn-text').textContent = 'Saving your spot...';

    // ── BEEHIIV SUBSCRIBE ──
    localStorage.setItem('gb_email', email);
    localStorage.setItem('gb_name', name);
    localStorage.setItem('gb_product', currentProduct);

    try {
      await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'shop_gate', tags: ['shop_buyer'] })
      });
    } catch (e) {
      // Non-blocking — still proceed to checkout even if the subscribe call fails
    }

    // Close modal
    document.getElementById('modal-overlay').classList.remove('open');
    document.body.style.overflow = '';

    // ── SHOW PROCESSING OVERLAY (2 seconds) ──
    const proc = document.getElementById('processing-overlay');
    proc.classList.add('active');

    await new Promise(r => setTimeout(r, 2000));

    // ── REDIRECT TO CHECKOUT (Same window to bypass blockers) ──
    if (currentEtsyUrl) {
      window.location.href = currentEtsyUrl;
      return; // Stop here as we are navigating away
    }

    proc.classList.remove('active');
  }

  // ── ESC TO CLOSE ──
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeGate();
  });

  // ── SCROLL REVEAL ──
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.product-card, .trust-item').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(14px)';
    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    observer.observe(el);
  });

  // ── THEME TOGGLE ──
  const toggleTheme = () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  document.getElementById('shopThemeToggle')?.addEventListener('click', toggleTheme);
  document.getElementById('shopThemeToggleMobile')?.addEventListener('click', toggleTheme);

  // ── MOBILE MENU TOGGLE ──
  const mobToggle = document.getElementById('shopMobileToggle');
  const mobMenu = document.getElementById('shopMobileMenu');
  const icMenu = mobToggle?.querySelector('.icon-menu');
  const icClose = mobToggle?.querySelector('.icon-close');

  mobToggle?.addEventListener('click', () => {
    mobMenu.classList.toggle('open');
    if (mobMenu.classList.contains('open')) {
      if(icMenu) icMenu.style.display = 'none';
      if(icClose) icClose.style.display = 'block';
    } else {
      if(icMenu) icMenu.style.display = 'block';
      if(icClose) icClose.style.display = 'none';
    }
  });

</script>

  <div id="shop-optin-modal" class="modal-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:1000; align-items:center; justify-content:center;">
    <div class="modal-content" style="background:#0f1115; border:1px solid #1e2730; padding:3rem; border-radius:12px; max-width:480px; text-align:center; position:relative;">
      <button id="close-shop-modal" style="position:absolute; top:1rem; right:1rem; background:none; border:none; color:#555; cursor:pointer;">✕</button>
      <h2 style="font-family:'Syne',sans-serif; font-size:2rem; margin-bottom:1rem; color:#fff;">Wait! Unlock <span style="color:#00e5a0;">10% Off.</span></h2>
      <p style="color:#8b9bb4; margin-bottom:2rem;">Join the list and get a 10% discount code for your first purchase in the ExpatBuildr shop.</p>

      <div id="shop-form">
        <input type="email" id="shop-modal-email" placeholder="Enter your email" style="width:100%; padding:1rem; background:#000; border:1px solid #1e2730; color:#fff; margin-bottom:1rem; outline:none;" />
        <button id="shop-modal-btn" style="width:100%; padding:1rem; background:#00e5a0; color:#000; border:none; font-weight:700; cursor:pointer; font-family:'Syne',sans-serif;">REVEAL MY DISCOUNT →</button>
      </div>
      <div id="shop-modal-success" style="display:none;">
        <p style="color:#00e5a0; font-weight:700; font-size:1.2rem;">CODE: GALAXY10</p>
        <p style="color:#8b9bb4; font-size:0.9rem; margin-top:0.5rem;">Use this at checkout. We also emailed it to you.</p>
      </div>
    </div>
  </div>

  <script is:inline src="/beehiiv-v2.js"></script>
  <script is:inline>
    // Trigger modal on exit intent
    let modalShown = false;
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY < 0 && !modalShown && !sessionStorage.getItem('shop_modal_dismissed')) {
        document.getElementById('shop-optin-modal').style.display = 'flex';
        modalShown = true;
      }
    });

    document.getElementById('close-shop-modal').addEventListener('click', () => {
      document.getElementById('shop-optin-modal').style.display = 'none';
      sessionStorage.setItem('shop_modal_dismissed', 'true');
    });

    const shopBtn = document.getElementById('shop-modal-btn');
    if (shopBtn) {
      shopBtn.addEventListener('click', async () => {
        const emailInput = document.getElementById('shop-modal-email');
        const email = emailInput.value.trim();
        const successDiv = document.getElementById('shop-modal-success');
        const formDiv = document.getElementById('shop-form');

        if (!isValidEmail(email)) {
          emailInput.style.borderColor = 'red';
          return;
        }

        shopBtn.textContent = 'Applying...';
        shopBtn.disabled = true;

        await subscribeToBeehiiv({
          email,
          tags: ["shop_visitor", "discount_code", "warm_lead"],
          utm_medium: "shop_page",
          utm_campaign: "shop_discount_exit"
        });

        formDiv.style.display = 'none';
        successDiv.style.display = 'block';
      });
    }
  </script>
</body>
</html>
