      <input type="email" id="gate-email" placeholder="you@email.com" autocomplete="email" />
    </div>

    <button class="modal-btn" id="modal-btn" onclick="handleGateSubmit()">
      <span id="modal-btn-text">Get Access + Checkout →</span>
    </button>

