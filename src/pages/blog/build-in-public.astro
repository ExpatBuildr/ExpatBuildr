---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Pencil, TrendingUp, Globe, Eye } from 'lucide-astro';
import YouTubeAd from '../../components/blog/YouTubeAd.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true && data.archived !== true : true;
});

const posts = allPosts
  .filter(p => p.data.pillarId === 'build-in-public' && p.data.category !== 'Pillar Hub')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);

const calcReadTime = (body: string) => Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 220));
---

<Layout
  title="Build in Public: One-Person Business from Southeast Asia | Expat Buildr"
  description="ExpatBuildr documented openly — the wins, failures, systems, and behind-the-scenes process of building a one-person business ecosystem from Southeast Asia."
  canonicalUrl="https://expatbuildr.com/blog/build-in-public"
  ogImage="/images/build-in-public-pillar.jpeg"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Build in Public Hub | Expat Buildr",
    "description": "The public execution log of ExpatBuildr — one-person business ecosystem documentation from Southeast Asia.",
    "url": "https://expatbuildr.com/blog/build-in-public",
    "publisher": {
      "@type": "Organization",
      "name": "Expat Buildr",
      "url": "https://expatbuildr.com"
    },
    "hasPart": posts.map(p => ({
      "@type": "BlogPosting",
      "headline": p.data.title,
      "url": `https://expatbuildr.com/blog/${p.id.replace(/\.mdx?$/, '')}`,
      "datePublished": p.data.pubDate.toISOString()
    }))
  })} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- YouTube Auto-Subscribe Banner -->
    <YouTubeAd class="mb-12" />

    <!-- Hero -->
    <div class="text-center mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 text-xs uppercase tracking-[0.2em] font-mono mb-8">
        <Pencil size={12} /> Build in Public
      </div>
      <h1 class="text-5xl md:text-7xl font-black font-display tracking-tighter text-slate-900 dark:text-white mb-6 uppercase leading-none">
        BUILD OPEN.<br /><span class="text-violet-400">COMPOUND TRUST.</span>
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto font-inter leading-relaxed mb-8">
        This pillar documents the journey of building a one-person business ecosystem from Southeast Asia. The wins, failures, systems, and behind-the-scenes process — published directly here on ExpatBuildr.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/newsletter" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-violet-500 text-white font-bold text-sm hover:bg-violet-400 transition-all">
          Weekly Intel <ArrowRight size={16} />
        </a>
        <a href="/consulting" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 font-semibold text-sm hover:border-violet-400/40 transition-all">
          Book Strategy Call
        </a>
      </div>
    </div>

    <!-- The Core Case -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      <div class="glass-card rounded-2xl p-6 border border-violet-500/20">
        <Eye class="text-violet-400 mb-3" size={24} />
        <div class="text-3xl font-black text-slate-900 dark:text-white mb-1">100%</div>
        <div class="text-sm text-slate-600 dark:text-slate-400">Transparent — no vanity metrics, no highlight reel. Real numbers, real decisions.</div>
      </div>
      <div class="glass-card rounded-2xl p-6 border border-violet-500/20">
        <TrendingUp class="text-violet-400 mb-3" size={24} />
        <div class="text-3xl font-black text-slate-900 dark:text-white mb-1">Ecosystem</div>
        <div class="text-sm text-slate-600 dark:text-slate-400">Lead generation, remote income, geo-arbitrage, and build in public — one compounding ecosystem.</div>
      </div>
      <div class="glass-card rounded-2xl p-6 border border-violet-500/20">
        <Globe class="text-violet-400 mb-3" size={24} />
        <div class="text-3xl font-black text-slate-900 dark:text-white mb-1">SEA-based</div>
        <div class="text-sm text-slate-600 dark:text-slate-400">Operating from Southeast Asia — geo-arbitrage as a structural advantage, not a lifestyle choice.</div>
      </div>
    </div>

    <!-- What Build in Public Means Here -->
    <div class="mb-20 prose prose-slate dark:prose-invert max-w-none">
      <h2 class="text-3xl font-black font-display uppercase tracking-tight text-slate-900 dark:text-white mb-6">What Build in Public Means Here</h2>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        Building in public is not content marketing dressed up as transparency. The goal here is to document actual decisions — what systems were built, what failed, what the numbers looked like, and why specific choices were made over alternatives.
      </p>
      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        The strategic logic is straightforward: public execution builds authority faster than private execution. All protocols, guides, build logs, and frameworks live directly here on ExpatBuildr.
      </p>
    </div>

    <!-- Article Index -->
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-8">
        <BookOpen class="text-violet-400" size={20} />
        <h2 class="text-2xl font-black font-display uppercase tracking-tight text-slate-900 dark:text-white">All Build in Public Guides</h2>
        <div class="h-px flex-1 bg-slate-200 dark:bg-white/10"></div>
        <span class="text-xs font-mono text-slate-400">{posts.length} guides</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {posts.map(post => (
          <a
            href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}
            class="group flex flex-col p-6 rounded-2xl border border-slate-200 dark:border-white/10 hover:border-violet-400/40 bg-white dark:bg-white/[0.03] hover:bg-violet-400/5 transition-all duration-300"
          >
            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-mono uppercase tracking-wider text-violet-400 font-semibold">{post.data.category}</span>
              <span class="text-xs text-slate-400">{formatDate(post.data.pubDate)}</span>
              {post.body && <span class="text-xs text-slate-400">{calcReadTime(post.body)} min read</span>}
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-violet-400 transition-colors leading-snug mb-2">{post.data.title}</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4 flex-1">{post.data.description}</p>
            <div class="flex items-center text-violet-400 font-bold text-xs uppercase tracking-widest gap-1 mt-auto">
              Read Guide <ArrowRight size={14} class="group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="rounded-2xl border border-violet-500/20 bg-violet-500/5 p-10 text-center mb-12">
      <h2 class="text-2xl font-black font-display uppercase tracking-tight text-slate-900 dark:text-white mb-3">Follow the Build as It Happens</h2>
      <p class="text-slate-600 dark:text-slate-400 mb-6 max-w-lg mx-auto">Weekly breakdowns on systems, income, geo-arbitrage, and the one-person business architecture — straight to your inbox.</p>
      <a href="/newsletter" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-violet-500 text-white font-bold hover:bg-violet-400 transition-all">
        Join Free <ArrowRight size={16} />
      </a>
    </div>

  </div>
</Layout>
