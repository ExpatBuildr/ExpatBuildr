---
// src/pages/consulting.astro
// 1-on-1 Consulting landing page — paid strategy call, Calendly + Stripe embed
// Styled to match the founders/* funnel pages (shared funnel.css tokens + page-scoped style block).
import Layout from '../layouts/Layout.astro';
import '../styles/funnel.css';

const title = "1-on-1 Consulting Call | ExpatBuildr";
const description = "Book a 1-on-1 relocation strategy call. Real numbers, real risks, mapped to your specific situation. $297 for 60 minutes.";
const canonicalUrl = "https://expatbuildr.com/consulting";
// TODO: no consulting-specific OG image exists yet at /images/consulting/og-consulting.png —
// falls back to Layout's site-wide default (/expatog.jpg) until one is created.
---

<Layout title={title} description={description} minimal={true} noAnimations={true}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "serviceType": "Relocation Consulting",
      "provider": {
        "@type": "Person",
        "name": "Tony Long II"
      },
      "areaServed": "Southeast Asia",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "297",
        "priceCurrency": "USD"
      }
    })} />
  </Fragment>

  <script is:inline>
    (() => {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
    })();
  </script>

  <nav>
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/logo.jpg" alt="ExpatBuildr Logo" class="nav-logo-img" />
        <div class="logo-text">Expat<span class="built">Buildr</span><span class="slug">/consulting</span></div>
      </a>
      <a href="#booking" class="nav-cta">Book Your Call →</a>
    </div>
  </nav>

  <main class="consulting-page">
    <section id="hero" class="wrap">
      <div class="kicker fade-1">1-on-1 Strategy Call · $297 / 60 Minutes</div>
      <h1 class="fade-2">Build your relocation plan<br /><em>with me directly.</em></h1>
      <p class="hero-sub fade-3">
        60 minutes. Your numbers, your timeline, your risks — mapped out with someone
        who's actually done this, not someone guessing from a blog post.
      </p>
    </section>

    <section class="wrap body-copy fade-3">
      <p>
        Most relocation content is either aspirational fluff or generic checklists that
        don't account for your actual situation. This call isn't that. We'll go through
        your specific budget, visa path, timeline, and the risks nobody talks about, and
        you'll leave with a real plan, not a vibe.
      </p>
    </section>

    <section class="wrap fit-check">
      <div class="section-tag">Fit Check</div>
      <div class="fit-grid">
        <div class="fit-column">
          <h2>This call is for you if:</h2>
          <ul>
            <li>You've decided you're moving and need a real plan, not more research</li>
            <li>You want your specific numbers checked against reality before you commit</li>
            <li>You're ready to ask the hard questions and act on the answers</li>
          </ul>
        </div>
        <div class="fit-column">
          <h2>This isn't the right fit if:</h2>
          <ul>
            <li>You're still deciding whether you even want to move</li>
            <li>You're looking for cheerleading, not a reality check</li>
            <li>You haven't looked at the free Playbook yet, start there first</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="wrap whats-included">
      <div class="section-tag">What's Included</div>
      <h2>Everything mapped to<br /><em>your situation.</em></h2>
      <ul class="included-list">
        <li>A short intake form before the call so we don't waste time on basics</li>
        <li>60 minutes, one-on-one, focused entirely on your situation</li>
        <li>A follow-up summary of what we covered and your next steps</li>
      </ul>
    </section>

    <section class="wrap about">
      <div class="section-tag">Who You're Talking To</div>
      <h2>Not theory.<br /><em>Lived it myself.</em></h2>
      <p>
        I run ExpatBuildr, where I teach the real numbers, real risks, and income systems
        behind actually relocating to Southeast Asia, not the highlight-reel version.
        I live in Cebu, Philippines, and everything I teach comes from doing this myself,
        not theorizing about it.
      </p>
      <h3>Why This Call Is Different</h3>
      <p>
        Most relocation advice online is either aspirational or recycled. I built
        ExpatBuildr specifically because that content was misleading people about what
        this actually costs and what actually goes wrong. This call is the same
        standard: your real numbers, your real risks, no filler.
      </p>
      <p class="access-note">
        I'm currently taking on my first round of 1-on-1 calls directly, which means
        you're getting my full attention and lower pricing before this becomes harder
        to book.
      </p>
    </section>

    <section class="wrap price">
      <div class="price-box">
        <div class="plan-price"><sup>$</sup>297</div>
        <div class="plan-delivery">60-minute call, one-on-one</div>
      </div>
    </section>

    <section id="booking" class="wrap booking">
      <div class="section-tag">Book Your Call</div>
      <h2>Pick a time<br /><em>that works for you.</em></h2>
      <!--
        TEMPORARY: reusing the /fixleaks Calendly event (free audit call, no payment
        collection) as a placeholder until a dedicated paid "consulting call" event
        type is created in Calendly with Stripe payment collection enabled.
        TODO: swap data-url below for the real paid event link once it exists —
        this one does NOT charge $297, it's just a stand-in so the page isn't broken.
      -->
      <div
        class="calendly-inline-widget"
        data-url="https://calendly.com/expatbuildr/fixmyleaks"
        style="min-width:320px;height:700px;"
      ></div>
      <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </section>

    <section class="wrap faq">
      <div class="section-tag">Questions</div>
      <div class="faq-item">
        <h3>What if I need to reschedule?</h3>
        <!-- TODO: reschedule policy left blank per instructions — not invented, needs your input -->
        <p></p>
      </div>
      <div class="faq-item">
        <h3>What if I'm not 100% decided yet?</h3>
        <p>
          Start with the free Playbook first, this call is for people ready to move,
          not people still weighing the idea.
        </p>
      </div>
      <div class="faq-item">
        <h3>Is this a sales call for other services?</h3>
        <p>No. This is planning time, not a pitch.</p>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <div class="footer-brand">Expat<span>Buildr</span> · 1-on-1 Relocation Consulting · Built in the Philippines 🇵🇭</div>
      <ul class="footer-links">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="https://x.com/expatbuildr" target="_blank" rel="noopener">X / Twitter</a></li>
      </ul>
    </div>
  </footer>
</Layout>

<style>
  nav { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--border); background: rgba(5,5,5,.92); backdrop-filter: blur(12px); }
  .nav-inner { max-width: 900px; margin: 0 auto; padding: 1rem clamp(1.25rem,5vw,2.5rem); display: flex; align-items: center; justify-content: space-between; }
  .nav-logo { display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .nav-logo-img { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; }
  .logo-text { font-family: var(--sans); font-weight: 900; font-size: 1.2rem; letter-spacing: -.04em; color: var(--text); }
  .logo-text .built { background: linear-gradient(135deg,var(--accent-1),var(--accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-weight: 400; }
  .logo-text .slug { font-family: var(--mono); font-size: .78rem; color: var(--text-dim); margin-left: .3rem; font-weight: 400; letter-spacing: .05em; }
  .nav-cta { display: inline-flex; align-items: center; font-family: var(--mono); font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; padding: .6em 1.2em; background: linear-gradient(135deg,var(--accent-1),var(--accent-2)); color: #000; transition: all .15s; }
  .nav-cta:hover { filter: brightness(1.1); }

  .wrap { max-width: 900px; margin: 0 auto; padding: 0 clamp(1.25rem,5vw,2.5rem); position: relative; z-index: 5; }
  .consulting-page section { padding: clamp(2.5rem,6vw,4rem) 0; border-top: 1px solid var(--border); }
  .consulting-page section:first-of-type { border-top: none; padding-top: clamp(3.5rem,9vw,6rem); }

  .section-tag { font-family: var(--mono); font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 1rem; display: flex; align-items: center; gap: .75rem; }
  .section-tag::after { content: ''; display: block; height: 1px; width: 3rem; background: var(--border-hi); }

  .kicker { font-family: var(--mono); font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; color: var(--accent-1); display: flex; align-items: center; gap: .6rem; margin-bottom: 1.5rem; }
  .kicker::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-1); animation: pulse 2s ease infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .4; transform: scale(.7); } }

  h1 { font-family: var(--serif); font-size: clamp(2.25rem,6vw,3.75rem); line-height: 1.1; letter-spacing: -.02em; margin-bottom: 1.25rem; max-width: 20ch; }
  h1 em { font-style: italic; color: var(--accent-1); }
  .hero-sub { font-size: 1.05rem; color: var(--text-muted); line-height: 1.75; max-width: 52ch; font-weight: 300; }

  h2 { font-family: var(--serif); font-size: clamp(1.6rem,3.5vw,2.5rem); line-height: 1.15; margin-bottom: 1rem; }
  h2 em { font-style: italic; color: var(--accent-1); }
  h3 { font-family: var(--serif); font-size: 1.2rem; margin: 1.5rem 0 .5rem; color: var(--text); }

  .body-copy p, .about p { color: var(--text-muted); font-size: 1rem; line-height: 1.75; max-width: 60ch; }

  .fit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 1.5rem; }
  .fit-column { background: var(--bg-2); padding: 1.75rem; }
  .fit-column h2 { font-size: 1.15rem; margin-bottom: .9rem; }
  .fit-column ul { list-style: none; }
  .fit-column li { font-size: .9rem; color: var(--text-muted); padding: .5rem 0; border-bottom: 1px solid var(--border); line-height: 1.6; display: flex; align-items: flex-start; gap: .6rem; }
  .fit-column li::before { content: '—'; color: var(--accent-1); flex-shrink: 0; }

  .included-list { list-style: none; margin-top: 1.5rem; }
  .included-list li { font-size: .95rem; color: var(--text-muted); padding: .75rem 0; border-bottom: 1px solid var(--border); display: flex; align-items: flex-start; gap: .6rem; line-height: 1.6; }
  .included-list li::before { content: '✓'; color: var(--accent-1); font-family: var(--mono); font-size: .8rem; flex-shrink: 0; margin-top: .15rem; }

  .access-note { font-style: italic; color: var(--text-dim); margin-top: 1.25rem; }

  .price { text-align: center; }
  .price-box { display: inline-block; }
  .plan-price { font-family: var(--serif); font-size: 3.5rem; color: var(--text); line-height: 1; }
  .plan-price sup { font-size: 1.25rem; vertical-align: super; color: var(--text-muted); }
  .plan-delivery { font-family: var(--mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); margin-top: .75rem; }

  .booking :global(.calendly-inline-widget) { margin-top: 1.5rem; border: 1px solid var(--border); background: var(--bg-2); }

  .faq-item { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .faq-item:first-of-type { margin-top: 1.5rem; }
  .faq-item h3 { font-family: var(--mono); font-size: .85rem; font-weight: 600; letter-spacing: .02em; margin: 0 0 .5rem; color: var(--text); }
  .faq-item p { font-size: .9rem; color: var(--text-muted); line-height: 1.65; min-height: 1em; }

  footer { position: relative; z-index: 5; border-top: 1px solid var(--border); padding: 1.75rem clamp(1.25rem,5vw,2.5rem); }
  .footer-inner { max-width: 900px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .footer-brand { font-family: var(--mono); font-size: .7rem; color: var(--text-dim); letter-spacing: .06em; }
  .footer-brand span { color: var(--accent-1); }
  .footer-links { display: flex; gap: 2rem; list-style: none; }
  .footer-links a { font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); text-decoration: none; transition: color .15s; }
  .footer-links a:hover { color: var(--accent-1); }

  @media (max-width: 640px) {
    .fit-grid { grid-template-columns: 1fr; }
    .fit-column { padding: 1.25rem 1rem; }
  }
</style>
